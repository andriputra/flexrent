# ============================================================================
# Flexrent — variabel environment. Salin ke .env lalu isi.
# Jangan pernah commit file .env.
# ============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
# DATABASE_URL = endpoint pooler (dipakai aplikasi runtime).
# DIRECT_URL   = endpoint direct (dipakai `prisma migrate`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-3.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.c-3.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# --- Auth.js v5 -------------------------------------------------------------
# Hasilkan dengan: npx auth secret
AUTH_SECRET="replace-me"
# Wajib diisi saat deploy (Vercel memberi URL sendiri untuk lokal).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Login Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sandi yang dipasang `npm run db:seed` untuk demo@flexrent.local.
# Kosong = memakai bawaan di prisma/seed.ts. Ganti kapan saja dengan
# `npm run account:password -- "email@rental.id" "sandi baru"`.
DEMO_PASSWORD=""

# Undangan staf + tautan masuk sekali pakai. Cara masuk utama tidak butuh ini:
# akun masuk dengan email + sandi. Kalau SMTP_* kosong, tombol "Kirim tautan
# masuk" disembunyikan dan isi email hanya dicetak ke log (lihat README).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Flexrent <noreply@example.com>"

# --- Penyimpanan file -------------------------------------------------------
# Vercel Blob. Kosongkan di dev → foto kendaraan dan foto checklist serah-terima
# disimpan ke /public/uploads, KTP/SIM disimpan ke /private/uploads (dua-duanya
# di-gitignore).
BLOB_READ_WRITE_TOKEN=""

# --- Dokumen pelanggan (KTP/SIM) --------------------------------------------
# Kunci HMAC untuk tanda tangan tautan /api/dokumen/{id} (umur default 5 menit).
# Kosongkan → memakai AUTH_SECRET.
DOCUMENT_SECRET=""

# --- Pembayaran Midtrans ----------------------------------------------------
# Kunci server Snap v2 (Dashboard Midtrans → Settings → Notification & Webhook;
# pilih tab Sandbox atau Production sesuai MIDTRANS_IS_SANDBOX).
# Kosong = pembayaran online mati total: tombol "Bayar sekarang" tidak muncul,
# createCheckoutAction menolak, dan /api/webhooks/midtrans menjawab 403.
MIDTRANS_SERVER_KEY=""
# Tidak dibaca kode. redirect_url dari Snap sudah membawa client key;
# isi hanya kalau nanti menambah Snap embedded JS di sisi klien.
MIDTRANS_CLIENT_KEY=""
# "false" = production (base api.midtrans.com), nilai lain = sandbox.
MIDTRANS_IS_SANDBOX="true"
# Tempel URL ini di Midtrans Dashboard → Webhook / Notification redirect:
#   https://{NEXT_PUBLIC_APP_URL}/api/webhooks/midtrans

# --- Notifikasi WhatsApp ----------------------------------------------------
# provider = fonnte | stub. "stub" (default) tidak mengirim apa pun: pesan
# dicetak ke log dan baris NotificationLog ditulis dengan detail "stub: ...".
# Fonnte butuh pulsa/api key aktif; nomor disimpan lokal (08…) dan dikonversi
# ke 62… saat kirim.
WHATSAPP_PROVIDER="stub"
FONNTE_API_KEY=""
# Opsional: nama/ID pengirim yang dipakai kolom `sender` Fonnte.
WHATSAPP_SENDER_ID=""

# --- Cron (GitHub Actions) --------------------------------------------------
# Header Authorization: Bearer ${CRON_SECRET} pada /api/cron/*
# /api/cron/booking-expired     → PENDING lewat expiresAt (2 jam) jadi EXPIRED
# /api/cron/booking-reminders   → pengingat H-1, hampir selesai, keterlambatan
# /api/cron/subscription        → PAST_DUE, pengingat perpanjangan H-7/H-3/H-1,
#                                 invoice periode berikutnya + notifikasinya
# Jadwal ada di .github/workflows/cron.yml (secret CRON_SECRET + variable APP_URL
# di repository GitHub); ketiga rute menolak 401 selama nilainya kosong atau
# masih "replace-me".
CRON_SECRET="replace-me"

# --- Aplikasi ---------------------------------------------------------------
# URL publik yang bisa dibuka pelanggan: dipakai untuk tautan status booking di
# pesan WhatsApp dan finish_url/redirect Midtrans. Di dev localhost sudah cukup.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
